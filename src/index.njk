---
layout: layouts/base.njk
title: "Kyle Lyon"
body_class: home-template
main_class: measure-60 measure-36-tablet responsive-24-phone
---
<div class="container">
  <h2>About</h2>
  <div class="columns bottom-1">
    <div class="column flex-measure-36 bottom-1">
      <table class="table table-compact-labels">
        <thead class="black bg-light-gray ba b--black">
          <tr>
            <th colspan="2">Profile</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Name</td><td>Kyle Lyon</td></tr>
          <tr><td>Occupation</td><td>Implementation Engineer</td></tr>
          <tr>
            <td>Previous<br/>Occupations</td>
            <td>
              Data Scientist<br/>
              Senior Project Manager<br/>
              Data Analyst<br/>
              Teaching Assistant, <a href="https://www.h4d.us/" target="_blank">H4D®</a><br/>
              Legislative Staffer
            </td>
          </tr>
          <tr><td>Employer</td><td><a href="https://www.air.ai/" title="Air" target="_blank">Air</a><br/>Arlington, VA<br/></td></tr>
          <tr><td>Previous Employers</td><td><a href="https://siliconmtn.com" title="Silicon Mountain Technologies" target="_blank">Silicon Mountain Technologies</a><br/><a href="https://icsb.org/" title="International Council for Small Business" target="_blank">ICSB</a><br/><a href="https://www.virtru.com/" title="Virtru" target="_blank">Virtru</a><br/><a href="https://www.house.gov/" title="U.S. House of Representatives" target="_blank">U.S. House of Representatives</a></td></tr>
          <tr><td>Education</td><td>MS, Business Analytics<br/>BBA, Marketing & Communications<br/><a href="https://www.gwu.edu/" title="The George Washington University" target="_blank">The George Washington University</a></td></tr>
        </tbody>
      </table>
    </div>
    <div class="column bottom-1">
      <table class="table table-compact-labels">
        <thead class="black bg-light-gray ba b--black">
          <tr><th colspan="2">Contact</th></tr>
        </thead>
        <tbody>
          <tr><td>Email</td><td><a href="mailto:office@lyon.computer">office@lyon.computer</a></td></tr>
          <tr><td>Github</td><td><a href="https://github.com/kyl3lyon" target="_blank">kyl3lyon</a></td></tr>
          <tr><td>X/Twitter</td><td><a href="https://x.com/kylelyon" target="_blank">kylelyon</a></td></tr>
          <tr><td>LinkedIn</td><td><a href="https://www.linkedin.com/in/lyon/" target="_blank">lyon</a></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  {% for sect in [ "notes","projects","studies","media" ] %}
  <div class="columns bottom-1">
    <div class="column flex-measure-60 bottom-1">
      <h2 class="inline-block">{{ sect | capitalize }}</h2>/ <a href="/{{ sect }}/" title="{{ sect | capitalize }} Archive">Archive →</a>
      <table class="table table-compact-labels">
        <thead class="black bg-light-gray ba b--black">
          <tr><th>Date</th><th>Title</th><th class="measure-6 hide-phone">Link</th></tr>
        </thead>
        <tbody>
          {% set items = collections[sect] | limit(5) %}
          {% if items | length %}
            {% for item in items %}
            <tr>
              <td><time datetime="{{ item.date | date('yyyy-MM-dd') }}">{{ item.date | date("yyyy-MM-dd") }}</time></td>
              <td><a href="{{ item.url }}" title="{{ item.data.title }}">{{ item.data.title }}</a></td>
              <td class="hide-phone"><a class="btn btn-sm bg-dark-green white hover-white hover-bg-black measure-6" href="{{ item.url }}" title="View {{ item.data.title }}">View →</a></td>
            </tr>
            {% endfor %}
          {% else %}
            <tr><td colspan="3">No items found.</td></tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>
  {% endfor %}
  <p class="ml-2"><a href="/site-index/" title="Site Index">Site Index →</a></p>
</div>


